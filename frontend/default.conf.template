# Modelo processado na subida do contêiner: a imagem oficial do nginx roda
# envsubst nos arquivos .template de /etc/nginx/templates.
#
# Só PORT e API_UPSTREAM são substituídas (NGINX_ENVSUBST_FILTER no Dockerfile);
# as variáveis do próprio nginx - $uri, $host, $remote_addr - passam intactas.
#
# Os padrões vivem no Dockerfile: PORT=80 e API_UPSTREAM=api:8080, que é o que
# o docker compose usa. Em plataformas como o Railway, onde a porta é sorteada
# e o outro serviço tem outro nome, basta definir as duas variáveis.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Não anuncia a versão do servidor.
    server_tokens off;

    # O HSTS fica no Caddy, que é quem termina o TLS.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # A aplicação não carrega nada de fora: script, estilo, imagem e chamadas
    # XHR são todos da própria origem.
    add_header Content-Security-Policy
        "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # O Angular é uma aplicação de página única: qualquer rota cai no index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Mesma origem do front, então o navegador não precisa de CORS.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # O mesmo teto que a API aceita para o upload da planilha.
        client_max_body_size 20m;

        # Consolidar uma planilha grande pode passar do padrão de 60s.
        proxy_read_timeout 120s;
    }
}
