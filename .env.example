# Copie para .env e troque os valores. O .env não vai para o git.

# Banco
POSTGRES_DB=fluxocaixa
POSTGRES_USER=fluxo
POSTGRES_PASSWORD=troque-esta-senha

# Assinatura do token: pelo menos 32 bytes.
# Gere uma com:  openssl rand -base64 48
JWT_CHAVE=troque-esta-chave-por-uma-aleatoria-de-32-bytes-ou-mais
JWT_MINUTOS=60

# Primeiro usuário, criado só quando a tabela está vazia.
# Troque a senha no primeiro acesso e apague estas linhas depois.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Administrador

# Anubis (prova de trabalho na entrada).
# Gere a chave com:  openssl rand -hex 32
ANUBIS_CHAVE=troque-por-64-caracteres-hexadecimais-gerados-aleatoriamente
ANUBIS_DIFICULDADE=4

# Porta pública da aplicação (é o Anubis quem atende).
PORTA_PUBLICA=8080
