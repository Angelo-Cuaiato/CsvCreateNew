# Variáveis para subir em uma PLATAFORMA de deploy (Railway, Render e afins).
#
# Não é o mesmo arquivo do .env: aquele é do docker compose, que traduz nomes
# curtos (JWT_CHAVE) para os que a API realmente lê (Jwt__ChaveSecreta). Fora do
# compose ninguém faz essa tradução, então aqui vão os nomes finais.
#
# Não existe um .env único na plataforma: cada serviço tem os seus. Cole cada
# bloco abaixo no serviço correspondente (no Railway, aba Variables > Raw Editor).


# ------------------------------------------------------------------ serviço api
# Root Directory: backend

ASPNETCORE_ENVIRONMENT=Production

# Gere a sua:  openssl rand -base64 48
# A API se recusa a subir em produção com uma chave que contenha "troque" ou
# "exemplo", justamente para ninguém publicar com o valor deste arquivo.
Jwt__ChaveSecreta=troque-esta-chave-por-uma-aleatoria-de-32-bytes-ou-mais
Jwt__MinutosDeValidade=60

# O IP de quem chama vem no X-Forwarded-For do proxy da plataforma; sem isto o
# limite de tentativas de login contaria todos os usuários no mesmo balde.
AtrasDeProxy=true

# A API aceita a URI pronta que a plataforma oferece e converte sozinha.
# Use a variante PRIVADA: a pública sai pela internet e é cobrada como tráfego.
# Se o serviço do banco não se chamar "Postgres", troque o nome dentro do ${{ }}.
ConnectionStrings__Postgres=${{Postgres.DATABASE_PRIVATE_URL}}

# Primeiro usuário, criado só quando a tabela está vazia. A senha de exemplo
# também é recusada em produção — ponha uma sua.
UsuarioInicial__Email=voce@suaempresa.com.br
UsuarioInicial__Senha=troque-esta-senha
UsuarioInicial__Nome=Administrador

# Só se o front não conseguir falar com a API: a rede privada dessas
# plataformas é IPv6, e este ajuste faz o Kestrel escutar nela também.
# ASPNETCORE_URLS=http://[::]:8080

# Só se você publicar a API em um domínio próprio (não é o recomendado — quem
# fala com ela é o nginx do front, pela rede privada).
# ASPNETCORE_HTTP_PORTS=${{PORT}}


# ------------------------------------------------------------------ serviço web
# Root Directory: frontend
#
# PORT a plataforma injeta sozinha; o nginx a lê do modelo default.conf.template.
# API_UPSTREAM é o endereço interno da API. No Railway o padrão é
# <nome-do-serviço>.railway.internal, e a API escuta na 8080.

API_UPSTREAM=api.railway.internal:8080


# ---------------------------------------------------------------- serviço banco
# Use o PostgreSQL gerenciado da própria plataforma: ele já vem com usuário,
# senha e banco criados, e é de lá que sai o DATABASE_PRIVATE_URL acima.
# Nada para definir aqui.


# ------------------------------------------------------------------- não vão lá
# ANUBIS_*  — o Anubis precisa ser o primeiro da fila para enxergar o IP real do
#             visitante, e nessas plataformas sempre há um proxy na frente.
# DOMINIO / EMAIL_TLS — são do Caddy; a plataforma já termina o HTTPS.
# POSTGRES_* — são do banco do compose; o gerenciado tem os seus.
